{
    "name": "xuey490/framework",
    "description": "A lightweight Powerful Fast, Simple, Secure PHP framework with Symfony components",
	"homepage": "https://github.com/xuey490/framework",
    "support": {
        "issues": "https://github.com/xuey490/framework/issues",
        "source": "https://github.com/xuey490/framework"
    },
    "type": "library",
	 "keywords": [
		"php",
		"novaphp",
		"symfony-components",
		"symfony",
		"Thinkphp",
		"ThinkORM",
		"FPM",
		"flexible",
		"php framework"
	],
    "license": "MIT",
    "authors": [
        {
            "name": "blue2004",
            "email": "xuey863toy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "casbin/casbin": "^4.2",
        "ezyang/htmlpurifier": "^4.18",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/config": "^12.58.0",
        "illuminate/database": "^12.58.0",
        "illuminate/events": "^12.58.0",
        "illuminate/pagination": "^12.58.0",
        "intervention/image": "^4.0.4",
        "lcobucci/clock": "^3.5",
        "lcobucci/jwt": "^5.6",
        "league/commonmark": "^2.6",
        "monolog/monolog": "^3.9.0",
        "phpoption/phpoption": "^1.9",
        "phpseclib/phpseclib": "^3.0",
        "predis/predis": "^3.3",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid": "^4.9.2",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation": "^7.4",
        "topthink/think-cache": "^3.0.1",
        "topthink/think-orm": "^4.0.51",
        "topthink/think-template": "^3.0.2",
        "topthink/think-validate": "^3.0.7",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6",
        "workerman/workerman": "^5.2.0",
        "xuey490/config": "^1.0.4",
        "xuey490/database": "^1.0.6",
        "xuey490/log": "^1.0.2",
        "xuey490/storage": "^1.1.3"
    },
    "require-dev": {		
        "friendsofphp/php-cs-fixer": "^3.88",
        "icanhazstring/composer-unused": "^0.9.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "*",
        "symfony/var-dumper": "^6.0 || ^7.0"	
    },
	"bin": ["bin/nova"],
    "autoload": {
        "psr-4": {
            "Framework\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Framework\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform-check": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "novaphp": {
            "config-files": [
                "config/app.php",
                "config/cache.php",
                "config/captcha.php",
                "config/database.php",
                "config/iplist.php",
                "config/log.php",
                "config/middleware.php",
                "config/mime_types.php",
                "config/redis.php",
                "config/routes.php",
                "config/services.php",
                "config/session.php",
                "config/site.php",
                "config/upload.php",
                "config/view.php"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Framework\\Composer\\ScriptHandler::copyDefaultConfig"
        ],
        "post-update-cmd": [
            "Framework\\Composer\\ScriptHandler::copyDefaultConfig"
        ],
        "test": "phpunit"
    },
	"minimum-stability": "stable", 
	"prefer-stable": true
}