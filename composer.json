{
    "name": "xuey490/framework",
    "description": "A lightweight Powerful Fast, Simple, Secure PHP framework with Symfony components",
    "homepage": "https://github.com/xuey490/framework",
    "support": {
        "issues": "https://github.com/xuey490/framework/issues",
        "source": "https://github.com/xuey490/framework"
    },
    "type": "composer-plugin",
    "keywords": [
        "php",
        "novaphp",
        "symfony-components",
        "symfony",
        "Thinkphp",
        "ThinkORM",
        "FPM",
        "flexible",
        "php framework"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "blue2004",
            "email": "xuey863toy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.3",
        "casbin/casbin": "^4.6",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^7.16",
        "illuminate/config": "^12.70",
        "illuminate/database": "^12.70",
        "illuminate/events": "^12.70",
        "illuminate/pagination": "^12.70",
        "illuminate/support": "^12.70",
        "intervention/image": "^4.4",
        "lcobucci/clock": "^3.5",
        "lcobucci/jwt": "^5.6",
        "league/commonmark": "^2.10",
        "monolog/monolog": "^3.12",
        "phpoption/phpoption": "^1.10",
        "phpseclib/phpseclib": "^3.0.57",
        "predis/predis": "^3.7",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0.2",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid": "^4.9.4",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation": "^7.4",
        "topthink/think-cache": "^3.0.1",
        "topthink/think-orm": "^4.0.51",
        "topthink/think-template": "^3.0.2",
        "topthink/think-validate": "^3.0.7",
        "twig/twig": "^3.30",
        "vlucas/phpdotenv": "^5.7",
        "workerman/workerman": "^5.2.3",
        "xuey490/config": "^1.0.4",
        "xuey490/database": "^1.0.7",
        "xuey490/log": "^1.0.2",
        "xuey490/storage": "^1.1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9.7",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^7.4"
    },
    "bin": [
        "bin/nova"
    ],
    "autoload": {
        "psr-4": {
            "Framework\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Framework\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "xuey490/framework": true
        },
        "platform-check": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "class": "Framework\\Composer\\InstallerPlugin",
        "plugin-modifies-downloads": false,
        "novaphp": {
            "config-files": [
                "config/app.php",
                "config/apps.php",
                "config/cache.php",
                "config/captcha.php",
                "config/casbin-model.conf",
                "config/casbin.php",
                "config/casbin_rbac_model.conf",
                "config/cookie.php",
                "config/database.php",
                "config/iplist.php",
                "config/jwt.php",
                "config/log.php",
                "config/middleware.php",
                "config/middlewares.php",
                "config/permission.php",
                "config/redis.php",
                "config/routes.php",
                "config/services.php",
                "config/session.php",
                "config/site.php",
                "config/storage.php",
                "config/tenant.php",
                "config/upload.php",
                "config/view.php"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Framework\\Composer\\ScriptHandler::copyDefaultConfig"
        ],
        "post-update-cmd": [
            "Framework\\Composer\\ScriptHandler::copyDefaultConfig"
        ],
        "install-config": "Framework\\Composer\\ScriptHandler::copyDefaultConfig",
        "phpstan": "phpstan analyse --memory-limit=1G -c phpstan.neon.dist --no-progress",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
